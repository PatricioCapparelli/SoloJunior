// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Seniority {
  PASANTIA  // Estudiantes
  TRAINEE   // 0 experiencia
  JUNIOR    // < 2 años
}

enum WorkMode {
  REMOTO
  HIBRIDO
  PRESENCIAL
}

// --- MODELOS ---

// Modelo para guardar empleos favoritos
model SavedJob {
  id        String   @id @default(cuid())
  userId    String   
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model Job {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  seniority   Seniority
  workMode    WorkMode
  company     String
  location    String?
  salary      String?
  url         String
  imageUrl    String?
  userId      String   
  views       Int      @default(0) 
  active      Boolean   @default(true)
  verified    Boolean  @default(false)
  approved    Boolean  @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reports     Report[] 
  savedBy     SavedJob[]
}

// Modelo para reportar ofertas sospechosas
model Report {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason    String   // Motivo del reporte (Spam, Fraude, etc.)
  details   String?  // Texto opcional
  createdAt DateTime @default(now())
}