// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS (Las reglas de oro) ---

// 1. Solo permitimos estos niveles. Si intentan meter "SSR", explota.
enum Seniority {
  PASANTIA  // Estudiantes
  TRAINEE   // 0 experiencia
  JUNIOR    // < 2 años
}

enum WorkMode {
  REMOTO
  HIBRIDO
  PRESENCIAL
}

// --- MODELOS ---

model Job {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  seniority   Seniority
  workMode    WorkMode
  company     String
  location    String?
  salary      String?
  url         String
  
  userId      String    
  
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}